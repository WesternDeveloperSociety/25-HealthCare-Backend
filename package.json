{
  "name": "25-healthcare-backend",
  "version": "1.0.0",
  "description": "backend for wds healthcare projects 2025",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "storage:up": "docker run -d --name fake-gcs --rm -p 4443:4443 fsouza/fake-gcs-server -scheme http",
    "storage:down": "docker stop fake-gcs",
    "storage:logs": "docker logs -f fake-gcs",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WesternDeveloperSociety/25-HealthCare-Backend.git"
  },
  "author": "ethan-rng",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WesternDeveloperSociety/25-HealthCare-Backend/issues"
  },
  "homepage": "https://github.com/WesternDeveloperSociety/25-HealthCare-Backend#readme",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@clerk/express": "^1.7.63",
    "@google-cloud/storage": "^7.18.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-zod-api": "^27.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.18.0",
    "prisma": "^7.3.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.16.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.14",
    "nodemon": "^3.1.10",
    "prettier": "^3.7.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
