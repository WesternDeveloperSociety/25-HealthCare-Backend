{
  "name": "25-healthcare-backend",
  "version": "1.0.0",
  "description": "backend for wds healthcare projects 2025",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WesternDeveloperSociety/25-HealthCare-Backend.git"
  },
  "author": "ethan-rng",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WesternDeveloperSociety/25-HealthCare-Backend/issues"
  },
  "homepage": "https://github.com/WesternDeveloperSociety/25-HealthCare-Backend#readme",
  "dependencies": {
    "@clerk/express": "^1.7.63",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "prisma": "^6.19.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^4.0.14",
    "nodemon": "^3.1.10",
    "prettier": "^3.7.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}